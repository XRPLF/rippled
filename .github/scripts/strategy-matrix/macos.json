{
  "platform": "macos/arm64",
  "runner": ["self-hosted", "macOS", "ARM64", "macos-26-apple-clang-21"],
  "configs": [
    {
      "build_type": "Release",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "events": [
        "pull_request",
        "ready_to_merge",
        "merge_group",
        "push",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "build_type": "Debug",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "build_only": true,
      "events": [
        "ready_to_merge",
        "merge_group",
        "push",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "build_type": "Release",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "toolchain": "nix",
      "events": [
        "ready_to_merge",
        "merge_group",
        "push",
        "schedule",
        "workflow_dispatch"
      ]
    },
    {
      "build_type": "Debug",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "toolchain": "nix",
      "build_only": true,
      "events": [
        "ready_to_merge",
        "merge_group",
        "push",
        "schedule",
        "workflow_dispatch"
      ]
    }
  ]
}
