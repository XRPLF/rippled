{
  "platform": "macos/arm64",
  "runner": ["self-hosted", "macOS", "ARM64", "macos-26-apple-clang-21"],
  "configs": [
    {
      "build_type": "Release",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "event": "pull_request"
    },
    {
      "build_type": "Debug",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "build_only": true,
      "event": "ready_to_merge"
    },
    {
      "build_type": "Release",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "toolchain": "nix",
      "event": "ready_to_merge"
    },
    {
      "build_type": "Debug",
      "extra_cmake_args": "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "toolchain": "nix",
      "build_only": true,
      "event": "ready_to_merge"
    }
  ]
}
