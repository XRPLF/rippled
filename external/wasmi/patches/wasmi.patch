 )
 
-if(WASMI_TARGET MATCHES "darwin")
-    set(INSTALLED_LIB "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}/libwasmi.dylib")
-    install(
-        FILES "${INSTALLED_LIB}"
