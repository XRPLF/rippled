-        COMPONENT Runtime
-    )
-    if(NOT CMAKE_INSTALL_NAME_TOOL)
-        message(WARNING "CMAKE_INSTALL_NAME_TOOL is not set. LC_ID_DYLIB for libwasmi.dylib will not be set.")
-    else()
-        set(install_name_tool_cmd
-            "${CMAKE_INSTALL_NAME_TOOL}"
-            "-id"
-            "@rpath/libwasmi.dylib"
-            "${INSTALLED_LIB}"
