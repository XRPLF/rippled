        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "xrpld_validations_Messages_In{exported_instance=~\"$node\", deployment_environment=~\"$deployment_environment\", xrpl_network_type=~\"$xrpl_network_type\", service_name=~\"$service_name\"}",
          "legendFormat": "Validations In [{{exported_instance}}]"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "xrpld_validations_Messages_Out{exported_instance=~\"$node\", deployment_environment=~\"$deployment_environment\", xrpl_network_type=~\"$xrpl_network_type\", service_name=~\"$service_name\"}",
          "legendFormat": "Validations Out [{{exported_instance}}]"
