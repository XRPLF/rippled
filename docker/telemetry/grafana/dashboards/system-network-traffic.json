            "type": "prometheus"
          },
          "expr": "xrpld_validations_untrusted_Messages_In{exported_instance=~\"$node\", deployment_environment=~\"$deployment_environment\", xrpl_network_type=~\"$xrpl_network_type\", service_name=~\"$service_name\"}",
          "legendFormat": "Untrusted In [{{exported_instance}}]"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "xrpld_validations_duplicate_Messages_In{exported_instance=~\"$node\", deployment_environment=~\"$deployment_environment\", xrpl_network_type=~\"$xrpl_network_type\", service_name=~\"$service_name\"}",
          "legendFormat": "Duplicate In [{{exported_instance}}]"
