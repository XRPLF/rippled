          "legendFormat": "Duplicate In [{{service_instance_id}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "axisLabel": "Messages",
            "spanNulls": true,
            "insertNulls": false,
