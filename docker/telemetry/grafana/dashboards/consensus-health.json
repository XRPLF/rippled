          },
          "queryType": "traceql",
          "query": "{name=\"consensus.accept.apply\" && resource.service.instance.id=~\"$node\"} | count_over_time() by (span.close_time_vote_bins)",
          "legendFormat": "{{span.close_time_vote_bins}} Vote Bins",
          "refId": "A"
