        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rippled_overhead_manifest_Bytes_Out{exported_instance=~\"$node\"}",
          "legendFormat": "Manifest Out [{{exported_instance}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "axisLabel": "Bytes",
            "spanNulls": true,
