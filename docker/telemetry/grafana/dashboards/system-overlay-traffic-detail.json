  "schemaVersion": 39,
  "tags": ["rippled", "statsd", "overlay", "network", "telemetry"],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "description": "Filter by rippled node (service.instance.id)",
        "type": "query",
        "query": "label_values(rippled_squelch_Messages_In, exported_instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": {
