#!/usr/bin/make -f

export DH_VERBOSE = 1
export DH_OPTIONS = -v

%:
	dh $@

override_dh_auto_configure override_dh_auto_build override_dh_auto_test:
	@:

override_dh_auto_install:
	# Primary FHS layout
	install -Dm0755 xrpld              debian/tmp/usr/bin/xrpld
	install -Dm0644 xrpld.cfg          debian/tmp/etc/xrpld/xrpld.cfg
	install -Dm0644 validators.txt     debian/tmp/etc/xrpld/validators.txt

	# Logrotate config (active by default)
	install -Dm0644 xrpld.logrotate    debian/tmp/etc/logrotate.d/xrpld

	# Update helper (not on PATH; the systemd update timer references it by absolute path)
	install -Dm0755 update-xrpld.sh    debian/tmp/usr/libexec/xrpld/update-xrpld.sh

	# Docs
	install -Dm0644 README.md          debian/tmp/usr/share/doc/xrpld/README.md
	install -Dm0644 LICENSE.md         debian/tmp/usr/share/doc/xrpld/LICENSE.md

# update-xrpld.service is a Type=oneshot fired by update-xrpld.timer; installing
# it without --no-start would run the update on package install.
override_dh_installsystemd:
	dh_installsystemd xrpld.service
	dh_installsystemd --name=update-xrpld --no-enable --no-start update-xrpld.service update-xrpld.timer

execute_before_dh_installtmpfiles:
	dh_installsysusers

override_dh_installsysusers:

override_dh_dwz:
	@:
